# ============================================================
# SmartFood AI — environment configuration
# Copy this file to `.env.local` and fill in your own keys.
# NEVER commit .env.local. NEVER hard-code keys in source code.
# ============================================================

# ------------------------------------------------------------
# AI PROVIDER (server-side only — the key NEVER reaches the browser)
# ------------------------------------------------------------
# Any OpenAI-compatible chat/vision API works.
# AI_PROVIDER is informational (e.g. openai | zai | ollama | custom).
# AI_BASE_URL must point at an OpenAI-compatible /v1 root, e.g.
#   https://api.openai.com/v1        (OpenAI)
#   http://localhost:11434/v1        (Ollama)
#   https://your-proxy.example.com/v1
# AI_MODEL          — text model for meal planning, forecasting, procurement…
# AI_VISION_MODEL   — vision-capable model used by AI Food Scanning
# Leave AI_API_KEY empty to run with the clearly-labelled "Demo AI" fallbacks.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=

# ------------------------------------------------------------
# MAP PROVIDER (client-side)
# ------------------------------------------------------------
# Supported providers: osm (default fallback, no key needed) | mapbox | google
# MAP_PROVIDER selects the tile/SDK adapter used by Explore Map, the
# registration location picker and the delivery route map.
# NEXT_PUBLIC_MAP_API_KEY — public client token for the chosen provider.
#   * Mapbox: pk.xxx token (restrict by URL/bundle in the provider console)
#   * Google: Maps JavaScript API key (restrict by referrer)
# NEXT_PUBLIC_MAP_STYLE — optional custom style URL (Mapbox style URL).
# When no key is configured the app falls back to OpenStreetMap tiles.
MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_API_KEY=
NEXT_PUBLIC_MAP_STYLE=

# ------------------------------------------------------------
# LAN DEVELOPMENT (testing from a phone)
# ------------------------------------------------------------
# Comma-separated extra origins allowed by the Next.js dev server so you can
# open http://<PC-IP>:3000 from a phone on the same Wi-Fi, e.g.:
# DEV_ALLOWED_ORIGINS=http://192.168.1.5:3000,http://192.168.1.20:3000
DEV_ALLOWED_ORIGINS=
